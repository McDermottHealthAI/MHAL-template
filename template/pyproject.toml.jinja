[build-system]
requires = ["setuptools>=80.9.0", "setuptools-scm>=9.2", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "[[ pypi_name ]]"
dynamic = ["version"] # Managed by setuptools-scm from git tags
authors = [
  {name="[[ author_name ]]", email="[[ author_email ]]"},
]
description = "[[ package_description ]]"
readme = "README.md"
requires-python = ">=[[ python_version ]]"
classifiers = [
    "Programming Language :: Python :: 3",
[%- if license == "MIT" %]
    "License :: OSI Approved :: MIT License",
[%- elif license == "Apache-2.0" %]
    "License :: OSI Approved :: Apache Software License",
[%- elif license == "BSD-3-Clause" %]
    "License :: OSI Approved :: BSD License",
[%- endif %]
    "Operating System :: OS Independent",
]
dependencies = [
]

[dependency-groups]
dev = [
  "pre-commit", "pytest", "pytest-cov", "pretty-print-directory",
  # Keep this pin in sync with the `ruff-pre-commit` rev in
  # .pre-commit-config.yaml. If the two drift, `uv run ruff format` and the
  # pre-commit hook can disagree and fight over the same files.
  "ruff==0.16.5",
  # shfmt-py bundles the `shfmt` binary used by the mdformat-shfmt pre-commit
  # hook. Pinning it here (in addition to the pre-commit hook's
  # additional_dependencies) gives a single source of truth and keeps local
  # `uv run mdformat ...` runs consistent with CI pre-commit runs.
  "shfmt-py==3.12.0.2",
]
docs = []

[tool.setuptools_scm]

[tool.pytest.ini_options]
addopts = [
  "--color=yes",
  "--doctest-modules",
  "--ignore=docs",
  "--ignore=AGENTS.md",
  "--ignore=CONTRIBUTORS.md",
  "--doctest-glob=*.md",
  "--doctest-continue-on-failure",
]
markers = []
doctest_optionflags = ["NORMALIZE_WHITESPACE", "ELLIPSIS"]

[project.urls]
Homepage = "https://github.com/[[ github_org ]]/[[ github_repo ]]"
Issues = "https://github.com/[[ github_org ]]/[[ github_repo ]]/issues"

[tool.ruff]
target-version = "py[[ python_version | replace('.', '') ]]"
line-length = 110
extend-exclude = ["docs/index.md"]

[tool.ruff.lint]
select = [
    "E",   # pycodestyle
    "F",   # pyflakes
    "I",   # isort
    "UP",  # pyupgrade
    "B",   # flake8-bugbear
    "C4",  # flake8-comprehensions
    "DTZ", # flake8-datetimez
    "RUF", # Ruff-specific rules
    "SIM", # flake8-simplify
    "TCH", # flake8-type-checking
    "N",   # pep8-naming
    "D",   # docstring-checker
]

[tool.ruff.lint.per-file-ignores]
"__init__.py" = ["F401"]  # Unused imports in __init__ files
"test_*" = ["DTZ001"]  # Ignore datetimez in test files

[tool.ruff.lint.pep8-naming]
extend-ignore-names = ["*MEDS*", "*NRT*", "D", "L"] # "D" is used for distributions/datasets

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.isort]
known-first-party = ["[[ package_name ]]"]
